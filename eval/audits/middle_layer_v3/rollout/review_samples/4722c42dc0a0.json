        "5.3",
        "5.3.1"
      ],
      "body": "5. 3. 1\n医疗等机构排水混接改造的洗涤废水严禁排入雨水系统。",
      "element_types": [
        "text"
      ],
      "pages": [
        18
      ],
      "bboxes": [
        {
          "physical_page": 18,
          "bbox": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-eval-golden-case-v1",
  "title": "RAG Golden Case v1",
  "type": "object",
  "required": ["id", "question", "evidence", "expected_facts", "labels", "doc_coverage"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^G[0-9]{3}$",
      "description": "稳定编号，如 G001；一经发布不改号"
    },
    "question": {
      "type": "string",
      "minLength": 4,
      "description": "用户真实会问的问法"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["doc_file", "quote"],
        "additionalProperties": false,
        "properties": {
          "doc_file": {"type": "string", "description": "主文本 display_file_name"},
          "standard_number": {"type": "string"},
          "chunk_id": {"type": ["string", "null"]},
          "element_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "page": {"type": ["integer", "null"], "minimum": 1},
          "quote": {"type": "string", "minLength": 8, "description": "应检索到的原文摘录"},
          "must_hit": {"type": "boolean", "default": true, "description": "是否计入 Recall 必命中集合"}
        }
      }
    },
    "expected_facts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 2},
      "description": "答案应覆盖的关键事实；拒答题写拒答/追问条件"
    },
    "labels": {
      "type": "object",
      "required": ["repr", "challenge"],
      "additionalProperties": false,
      "properties": {
        "repr": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["定义", "数值", "条件", "范围例外", "表格", "流程要求", "拒答"]
          },
          "minItems": 1
        },
        "challenge": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["同义表达", "多条件", "多证据", "跨页", "多文档", "表格", "相似干扰", "公式", "图片", "原文定位", "库外"]
          }
        },
        "modality": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["正文", "表格", "公式", "图片图注"]
          }
        }
      }
    },
    "doc_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "本条计入覆盖的主文本 display_file_name 列表（通常 1 个；多证据可多个）"
    },
    "notes": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "frozen"],
      "default": "draft"
    }
  }
}

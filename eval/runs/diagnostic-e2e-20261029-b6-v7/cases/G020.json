{
  "case": "G020",
  "question": "《城镇分流制排水系统雨污混接调查》征求意见稿中，图5-1的图名是什么？条文解释举例用什么水质指标做筛查？",
  "expected_answerability": "answer",
  "request_id": "diagnostic-e2e-20261029-b6-v7-G020",
  "trace_missing": false,
  "wall_ms": 10002.5,

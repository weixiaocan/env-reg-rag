{
  "case": "G022",
  "question": "依据QX/T 489—2019《降雨过程等级》，单站日降雨量等级如何划分？暴雨与大暴雨对应的日降雨量区间分别是多少？",
  "expected_answerability": "answer",
  "request_id": "diagnostic-e2e-20261029-b6-v7-G022",
  "trace_missing": false,
  "wall_ms": 6582.093,
  "http_status": 200,
  "status": "answered",
  "answer": {
    "claims": [
      {
        "claim_id": "claim-1",
        "text": "依据《降雨过程等级》（QX/T 489—2019）第3.1条，单站日降雨量等级以该站日降雨量为划分依据，共分为小雨、中雨、大雨、暴雨、大暴雨、特大暴雨六个等级。",
        "evidence_ids": [
          "chunk_1ad733b3c3edacb4076ad5f38a7246d6",
          "chunk_30982fa92ea6b48d138906733ca5fb98"
        ],
        "verified": true
      },
      {
        "claim_id": "claim-2",
        "text": "各等级对应的日降雨量区间如下：",
        "evidence_ids": [
          "chunk_30982fa92ea6b48d138906733ca5fb98"
        ],
        "verified": true
      },
      {
        "claim_id": "claim-3",
        "text": "\n\n- 小雨：0.1~9.9 mm\n- 中雨：10.0~24.9 mm\n- 大雨：25.0~49.9 mm\n- 暴雨：50.0~99.9 mm\n- 大暴雨：100.0~249.9 mm\n- 特大暴雨：≥250.0 mm\n\n其中，暴雨对应的日降雨量区间为50.0~99.9 mm，大暴雨对应的日降雨量区间为100.0~249.9 mm。",
        "evidence_ids": [
          "chunk_30982fa92ea6b48d138906733ca5fb98"
        ],
        "verified": true
      }
    ],
    "conflicts": []
  },

{
  "case": "G017",
  "question": "按GB 55027表3.3.2，超大城市和特大城市在“中心城区的重要地区”与“中心城区地下通道和下沉式广场等”的雨水管渠设计重现期分别取多少？",
  "expected_answerability": "answer",
  "request_id": "diagnostic-e2e-20261024-ed28-G017",
  "trace_missing": false,

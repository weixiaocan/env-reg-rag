  "answer": {
    "claims": [
      {
        "claim_id": "claim-1",
        "text": "地面集水时间应根据汇水距离、地形坡度、地面种类和暴雨强度等因素通过计算确定。",
        "evidence_ids": [
          "chunk_571002af76acd54f97035960931ed705",

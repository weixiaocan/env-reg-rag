__pycache__/
*.pyc
.pytest_cache/
.venv/
.uv-cache/
.env
.env.*
!.env.example
data/chroma/
data/*.pkl
data/*.bin
_archive/
data/registry/*.sqlite3
*.sqlite
*.sqlite3
*.db
data/observability/*.jsonl
data/backups/
tmp/

# The public repository intentionally bundles source PDFs. The global PDF rule
# still protects PDFs created elsewhere; only data/raw is explicitly included.
*.pdf
!data/raw/
!data/raw/**/
!data/raw/**/*.pdf
*.docx

# Large, rebuildable parsing outputs and local evaluation runs.
data/canonical/
data/eval_results/

# Local databases, vector stores, logs, model caches and other runtime state.
data/qdrant/
data/model_runtime/
logs/
*.log
models/
.cache/

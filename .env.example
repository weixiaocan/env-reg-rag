# Copy this file to .env and fill your real keys.
# Do not commit .env to public repositories.

# Answer model. The current development provider is Zhipu's OpenAI-compatible API.
LLM_PROVIDER=zhipu
LLM_MODEL=glm-5.2
ZAI_API_KEY=replace-with-your-zhipu-api-key

# Optional provider switches for later comparison. Set LLM_PROVIDER and LLM_MODEL too.
OPENAI_API_KEY=replace-with-your-openai-api-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Optional overrides.
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Public demo safety net. Also configure edge rate limits and a provider spend cap.
# Use `demo` only for the owner-funded public interview site. The repository
# default is `self_hosted`, where the operator supplies their own model key.
APP_PROFILE=self_hosted
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_SOURCE_LOOKUP_PER_MINUTE=30
PUBLIC_ANSWER_PER_MINUTE=3
PUBLIC_ANSWER_PER_CLIENT_DAILY=10
PUBLIC_ANSWER_DAILY_BUDGET=20


# Optional token prices for auditable cost estimation. Keep both unset when the
# provider price has not been verified; traces will record `not_configured`.
# LLM_INPUT_COST_PER_MILLION=replace-with-current-input-price
# LLM_OUTPUT_COST_PER_MILLION=replace-with-current-output-price
# LLM_COST_CURRENCY=CNY

# EMBEDDING_API_KEY is optional when embedding.provider=local.

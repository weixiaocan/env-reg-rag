{"schema_version": "1", "chunk_id": "chunk_e82cc863ac0a90602446fca666dbe6ff", "text": "标准号：GB/T 28592-2012\n文档：GBT 28592-2012降水量等级.pdf\n标题路径：1 范围\n原文：本标准规定了降水量等级划分的原则和等级。 本标准适用于降水监测、预报、预警、服务等业务和科研工作，以及其他行业与降水相关的领域。", "evidence_ids": ["ev_2bcafb1fba5fc5f8c1a77c88b75b1ae1"], "primary_evidence_id": "ev_2bcafb1fba5fc5f8c1a77c88b75b1ae1", "document_version_id": "doc_f28bb600c89914f7", "evidence_type": "paragraph", "physical_pages": [4], "metadata": {"standard_number": "GB/T 28592-2012", "document_kind": "standard", "jurisdiction": "全国", "effective_status": "current", "file_name": "GBT 28592-2012降水量等级.pdf", "source_uri": "", "heading_path": ["1 范围"], "context_scope": "page_local_inferred", "quality_status": "approved", "usage_policy": "answer_and_citation", "text_reliability": "quality_gate_approved", "official_source_uri": "https://www.cma.gov.cn/zfxxgk/gknr/flfgbz/bz/202209/P020220921551942529160.pdf", "source_authority": "中国气象局", "source_review": "official_fulltext_verified", "publication_date": "2012-06-29", "effective_from": "2012-08-01", "effective_to": "9999-12-31", "local_file_match": "sha256_match", "selection_status": "approved_formal"}}

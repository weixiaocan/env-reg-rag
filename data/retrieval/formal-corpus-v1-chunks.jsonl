{"schema_version": "1", "chunk_id": "chunk_20003802d88f48c72462aa2b25e48205", "text": "标准号：GB/T 28592-2012\n文档：GBT 28592-2012降水量等级.pdf\n标题路径：降水量precipitation\n原文：某一时段内，从天空降落到地面上的液态（降雨）或固态（降雪）（经融化后）降水，未经蒸发、渗透、流失而在水平面上积聚的深度。", "evidence_ids": ["ev_d3e6b2c77d7331eca12aa859e67166b0"], "primary_evidence_id": "ev_d3e6b2c77d7331eca12aa859e67166b0", "document_version_id": "doc_f28bb600c89914f7", "evidence_type": "paragraph", "physical_pages": [4], "metadata": {"standard_number": "GB/T 28592-2012", "document_kind": "standard", "jurisdiction": "全国", "effective_status": "current", "file_name": "GBT 28592-2012降水量等级.pdf", "source_uri": "", "heading_path": ["降水量precipitation"], "context_scope": "page_local_inferred", "quality_status": "approved", "usage_policy": "answer_and_citation", "text_reliability": "quality_gate_approved", "official_source_uri": "https://www.cma.gov.cn/zfxxgk/gknr/flfgbz/bz/202209/P020220921551942529160.pdf", "source_authority": "中国气象局", "source_review": "official_fulltext_verified", "publication_date": "2012-06-29", "effective_from": "2012-08-01", "effective_to": "9999-12-31", "local_file_match": "sha256_match", "selection_status": "approved_formal"}}
